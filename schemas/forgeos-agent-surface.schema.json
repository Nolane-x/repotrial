{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repotrial.dev/schemas/forgeos-agent-surface.schema.json",
  "title": "ForgeOS v0.6 Agent Surface generated by RepoTrial",
  "type": "object",
  "additionalProperties": false,
  "required": ["instructions", "hooks", "mcpServers", "packages", "allowedCommands", "envReferences"],
  "properties": {
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "text"],
        "properties": {
          "path": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "event", "script"],
        "properties": {
          "id": { "type": "string" },
          "event": { "type": "string" },
          "script": { "type": "string" }
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "tools"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "permissions"],
              "properties": {
                "name": { "type": "string" },
                "permissions": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scripts"],
        "properties": {
          "name": { "type": "string" },
          "scripts": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "allowedCommands": { "type": "array", "items": { "type": "string" } },
    "envReferences": { "type": "array", "items": { "type": "string" } }
  }
}
