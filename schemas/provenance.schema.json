{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repotrial.dev/schemas/provenance.schema.json",
  "title": "RepoTrial in-toto SLSA Provenance",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "predicateType": { "const": "https://slsa.dev/provenance/v1" },
    "subject": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["buildDefinition", "runDetails"]
    }
  }
}
