{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repotrial.dev/schemas/reasoning.schema.json",
  "title": "RepoTrial Evidence Reasoning v1",
  "type": "object",
  "required": ["schemaVersion", "graph", "hypotheses", "attackPaths", "remediation", "summary"],
  "properties": {
    "schemaVersion": { "const": "repotrial.reasoning.v1" },
    "graph": {
      "type": "object",
      "required": ["schemaVersion", "nodes", "edges"],
      "properties": {
        "schemaVersion": { "const": "repotrial.evidence-graph.v1" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "enum": ["EVIDENCE", "SAFEGUARD", "CAPABILITY", "CLAIM"] }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to", "relation"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "relation": { "enum": ["SUPPORTS", "ENABLES", "MITIGATES", "REQUIRES"] }
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "state", "confidence", "requiredStages", "supportingEvidenceIds", "missingStages", "contradictions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "state": { "enum": ["PROVEN", "SUPPORTED", "CONTRADICTED", "REFUTED", "UNKNOWN", "UNTESTED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "requiredStages": { "type": "array" },
          "supportingEvidenceIds": { "type": "array", "items": { "type": "string" } },
          "missingStages": { "type": "array", "items": { "type": "string" } },
          "contradictions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "attackPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hypothesisId", "severity", "viability", "confidence", "stages", "supportingEvidenceIds", "missingStages", "contradictions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hypothesisId": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "viability": { "enum": ["VIABLE", "PARTIAL", "BLOCKED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "stages": { "type": "array" },
          "supportingEvidenceIds": { "type": "array", "items": { "type": "string" } },
          "missingStages": { "type": "array", "items": { "type": "string" } },
          "contradictions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "remediation": {
      "type": "object",
      "required": ["schemaVersion", "model", "caveat", "candidates"],
      "properties": {
        "schemaVersion": { "const": "repotrial.counterfactual-remediation.v1" },
        "model": { "const": "counterfactual-charge-removal-v1" },
        "caveat": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["evidenceNodeCount", "capabilityCount", "hypothesisCounts", "attackPathCounts", "maximumReasoningSeverity", "confidenceFloor", "topRemediationEvidenceIds"],
      "properties": {
        "evidenceNodeCount": { "type": "integer", "minimum": 0 },
        "capabilityCount": { "type": "integer", "minimum": 0 },
        "maximumReasoningSeverity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "confidenceFloor": { "type": "number", "minimum": 0, "maximum": 1 },
        "topRemediationEvidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
