{
  "name": "repotrial",
  "version": "0.8.0",
  "description": "Deterministic evidence reasoning, causal attack synthesis, autonomous threat discovery, evidence realms, active verification, runtime, and supply-chain security for AI-agent repositories.",
  "type": "module",
  "bin": {
    "repotrial": "./bin/repotrial.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "integrations",
    "scripts",
    "schemas",
    "docs/architecture.md",
    "docs/attestations.md",
    "docs/differential-analysis.md",
    "docs/evidence-reasoning.md",
    "docs/adaptive-experiments.md",
    "docs/forgeos-bridge.md",
    "docs/runtime-sandbox.md",
    "docs/supply-chain.md",
    "README.md",
    "README-VN.md",
    "README.vi.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/causal-adversarial-reasoning.md",
    "tests/adversarial-corpus",
    "docs/autonomous-threat-discovery.md"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "check": "node scripts/check.mjs",
    "scan:self": "node bin/repotrial.mjs scan . --output .repotrial",
    "start": "node bin/repotrial.mjs serve .repotrial",
    "package:check": "npm pack --dry-run",
    "verify:forgeos": "node scripts/verify-forgeos-integration.mjs",
    "benchmark:adversarial": "node scripts/benchmark-adversarial.mjs",
    "benchmark:discovery": "node scripts/benchmark-discovery.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent-security",
    "adaptive-security",
    "adversarial-testing",
    "security",
    "static-analysis",
    "runtime-sandbox",
    "evidence-graph",
    "attack-path",
    "threat-modeling",
    "sbom",
    "cyclonedx",
    "osv",
    "sigstore",
    "slsa",
    "sarif",
    "forgeos",
    "mcp",
    "github-action",
    "causal-security",
    "attack-chain",
    "active-verification",
    "agentic-security",
    "security-benchmark",
    "autonomous-threat-discovery",
    "evidence-realms",
    "security-reasoning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nolane-x/repotrial.git"
  },
  "homepage": "https://github.com/Nolane-x/repotrial#readme",
  "bugs": {
    "url": "https://github.com/Nolane-x/repotrial/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
